<resources>
    <style name="Theme.Hwallet" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/kw_lime</item>
        <item name="android:windowSplashScreenBackground">@color/kw_lime</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/hw_splash_h</item>
    </style>
    <!-- Material You: splash + window follow the wallpaper palette (chosen in Settings) -->
    <style name="Theme.Hwallet.Md3" parent="Theme.Hwallet">
        <item name="android:windowBackground">@android:color/system_accent1_100</item>
        <item name="android:windowSplashScreenBackground">@android:color/system_accent1_100</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/hw_splash_h_md3</item>
    </style>
    <style name="Theme.Hwallet.Md3Dark" parent="Theme.Hwallet">
        <item name="android:windowBackground">@android:color/system_neutral1_900</item>
        <item name="android:windowSplashScreenBackground">@android:color/system_neutral1_900</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/hw_splash_h_md3_dark</item>
    </style>
</resources>
