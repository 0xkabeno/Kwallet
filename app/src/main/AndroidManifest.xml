<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Kwallet is fully offline: there is deliberately NO INTERNET permission. -->
    <!-- v3.99.14: safety net, no library may merge INTERNET into Kwallet's manifest -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <!-- v3.99.14: QR air-gap scanner (asked only when the user opens it); phones without a camera can still install -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- v3.90: the sign page hides other apps' overlays (anti-tapjacking, Android 12+) -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!-- v3.91: live fee / balance updates from Hwallet to the open sign page. Only apps signed with the
         Kwallet key can hold this permission (Hwallet declares the same one, so install order does not matter). -->
    <permission android:name="app.kwallet.permission.SIGN_FEED" android:protectionLevel="signature" />
    <!-- v3.98.32: Kwallet tells Hwallet at once when a paired seed is removed or Kwallet is erased (an explicit broadcast to
         Hwallet's KwEventReceiver, which requires this permission from the sender) -->
    <uses-permission android:name="app.kwallet.permission.SIGN_FEED" />

    <!-- v3.90: Kwallet checks that Hwallet is signed with the same key before it signs anything -->
    <queries>
        <package android:name="app.hwallet" />
    </queries>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kwallet"
        tools:targetApi="34">

        <activity
            android:name=".KwActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize|uiMode|density"
            android:windowSoftInputMode="adjustResize" />

        <!-- v3.90 Hwallet sign page: only reachable by an explicit request from Hwallet (checked in code) -->
        <activity
            android:name=".SignActivity"
            android:exported="true"
            android:theme="@style/Theme.KwSign"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="standard"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize|uiMode|density"
            android:windowSoftInputMode="adjustResize" />

        <!-- P2a (#97a): Hwallet wakes Kwallet's process (and loads the WebView engine) just before it may ask for a signature,
             so the sign sheet opens fast. Only apps signed with the Kwallet key may send it; it starts nothing visible. -->
        <receiver
            android:name=".WarmReceiver"
            android:exported="true"
            android:permission="app.kwallet.permission.SIGN_FEED">
            <intent-filter>
                <action android:name="app.kwallet.WARM" />
            </intent-filter>
        </receiver>

        <!-- K-H link: the persistent K <-> H link. Hwallet binds it only while it is on screen (ping every ~5 s, warm the sign
             page, live fee / balance / price feed for the open sheet). Signature permission to bind + caller uid / signature
             check on every transaction. Not a foreground service; it starts nothing visible and uses no network. -->
        <service
            android:name=".KwLinkService"
            android:exported="true"
            android:permission="app.kwallet.permission.SIGN_FEED" />

        <!-- v3.98.32: Hwallet reads this Kwallet's install id and the public IDs of its paired seeds (no PIN, no keys), so it
             erases wallets of seeds Kwallet no longer holds. Signature permission + caller uid / signature check in code. -->
        <provider
            android:name=".KwLinkProvider"
            android:authorities="app.kwallet.link"
            android:exported="true"
            android:permission="app.kwallet.permission.SIGN_FEED" />

        <!-- Launcher icons. Settings > App icon enables one alias and disables the other.
             The lime alias keeps the old component name so existing home-screen shortcuts survive updates. -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".KwActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconNavy"
            android:targetActivity=".KwActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_navy"
            android:roundIcon="@mipmap/ic_launcher_navy_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
