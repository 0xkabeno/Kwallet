<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Kwallet is fully offline: there is deliberately NO INTERNET permission. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- v3.90: the sign page hides other apps' overlays (anti-tapjacking, Android 12+) -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!-- v3.90: Kwallet checks that Hwallet is signed with the same key before it signs anything -->
    <queries>
        <package android:name="app.hwallet" />
    </queries>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kwallet"
        tools:targetApi="34">

        <activity
            android:name=".KwActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize|uiMode|density"
            android:windowSoftInputMode="adjustResize" />

        <!-- v3.90 Hwallet sign page: only reachable by an explicit request from Hwallet (checked in code) -->
        <activity
            android:name=".SignActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="standard"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize|uiMode|density"
            android:windowSoftInputMode="adjustResize" />

        <!-- Launcher icons. Settings > App icon enables one alias and disables the other.
             The lime alias keeps the old component name so existing home-screen shortcuts survive updates. -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".KwActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconNavy"
            android:targetActivity=".KwActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_navy"
            android:roundIcon="@mipmap/ic_launcher_navy_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
